<Window x:Class="ImgConv.HelpWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ユーザーマニュアル" Width="680" Height="620" MinWidth="520" MinHeight="400" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <Button DockPanel.Dock="Bottom" Content="閉じる" Width="100" Padding="8" HorizontalAlignment="Right" Click="Close_Click"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="SnapImg ユーザーマニュアル" FontSize="24" FontWeight="Bold" Margin="0,0,0,18"/>
        <TextBlock Text="画像ファイルを JPG、PNG、WEBP、AVIF、BMP などへ変換する Windows アプリです。" TextWrapping="Wrap" Margin="0,0,0,18"/>
        <TextBlock Text="基本操作" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Text="1. 「ファイルを追加」または「フォルダを追加」で画像を登録します。&#x0a;2. 出力形式、画質、Exif、リサイズ、保存先を設定します。&#x0a;3. 「変換を開始」を押します。&#x0a;&#x0a;画像やフォルダをファイル一覧へドラッグ＆ドロップして追加することもできます。" TextWrapping="Wrap" Margin="0,0,0,18"/>
        <TextBlock Text="対応形式" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Text="入力: HEIC / HEIF / AVIF / JPG / JPEG / PNG / WEBP / BMP / TIFF / GIF / ICO&#x0a;出力: JPG / PNG / WEBP / AVIF / BMP" TextWrapping="Wrap" Margin="0,0,0,18"/>
        <TextBlock Text="設定について" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Text="JPEG と WEBP の画質は 10～100 で設定できます。Exif 情報を保持したくない場合はチェックを外してください。幅・高さを入力するとリサイズできます。保存先を指定しない場合は元画像と同じフォルダへ保存されます。" TextWrapping="Wrap" Margin="0,0,0,18"/>
        <TextBlock Text="右クリックメニュー" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Text="「設定」から JPG / PNG / WEBP / AVIF / BMP の右クリック変換メニューを登録・解除できます。Windows 11 では「その他のオプションを確認」に表示される場合があります。" TextWrapping="Wrap" Margin="0,0,0,18"/>
        <TextBlock Text="注意" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Text="変換後に同名ファイルがある場合は連番が付加され、元画像は上書きされません。アニメーション AVIF は対象外です。" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
